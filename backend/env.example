# 数据库配置
MONGODB_URI=mongodb://localhost:27017/html_tools
# 或者使用 MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/html_tools

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# 服务器配置
PORT=5000
NODE_ENV=development

# CORS配置
FRONTEND_URL=http://localhost:3000
